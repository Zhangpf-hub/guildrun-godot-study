[node name="UnityText" type="Label" parent="Canvas/Root/TutorialPanel/Image/Mask/Text (TMP)"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
text = "<b><size=140%>Game Overview</b>\n<size=100%>------------------------\r\nRift Reborn is a roguelike auto battler where you assemble a team of heroes to battle against increasingly powerful monsters in fully simulated combat. Defeating enemies and completing events earns you <b>Shards,</b> which can be used to purchase <b>Heroes, Items, and Relics</b> from the <b>shop.</b>\r\n\r\n<b>If your team is defeated in battle, the Shard Stabilizer will keep your run alive once</b> and give you a boost of Shards for the next battle. The further you had made it before being defeated, the bigger the Shard boost will be. If your team is defeated a second time, then your run will end in defeat.\r\n\r\nIf you manage to defeat the final boss, your team will proceed to <b>Endless Mode</b> - an infinite wave of enemies which get stronger and stronger every fight. Climb your way to the top of the leaderboard by defeating as many endless waves as you can!\r\n\r\n<b>If you ever wish to know more about how something works, most things in the game can be inspected by hovering your mouse over it</b>. You can also hold the <b>Shift</b> key to expand these descriptions for explanations of the game’s various keywords.\r\n\r\n<size=140%><b>Heroes</b>\r\n<size=100%>-----------\r\nHeroes are the focus of Rift Reborn. Each hero has its own unique abilities, classes, and stats. Gaining a duplicate copy of hero ranks them up, increasing their stats and allowing the player to choose an upgrade. Heroes start at <b>Rank C</b>. At <b>Rank B</b>, heroes unlock a powerful and hero-specific <b>specialization</b>. At <b>Rank A and Rank S</b> heroes unlock new passive ability from a pool of options depending on their class. \r\n\r\n<b>Active abilities</b> trigger every time a hero’s mana bar is full. Heroes gain whenever they attack, and with the <b>Mana Regen</b> stat. <b>Passive abilities</b> do not need mana to trigger and are always in effect. \r\n\r\nIf a hero dies in combat, they become <b>unstable</b>. If they die again while unstable, they will become <b>banished</b> and leave your team. An unstable hero can become <b>stable</b> again if you <b>rest</b> them by leaving them in the <b>reserve</b> for one combat. A banished hero can be returned to your team at the <b>campfire</b>.\r\n\r\n<size=140%><b>Items & Relics</b>\r\n<size=100%>---------------------\r\n<b>Items</b> can give heroes additional stats and new abilities. Each hero can equip 3 items by default. Items must be equipped to a hero in order to function. Items can not be equipped to a hero mid-battle, so remember to equip them before the battle starts! Items can be sold for 50% of their cost in the shop.\r\n\r\n<size=140%><b>Relics</b><size=100%> apply bonuses to your entire team. They do not need to be equipped. Relics can not be sold."
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.952941239, 0.929411829, 0.847058892, 1)
horizontal_alignment = 0
vertical_alignment = 0

