[node name="UnityText" type="Label" parent="Canvas/Root/VersionMessageWindow/Image/Mask/Text (TMP)"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
text = "Welcome to <b>The Rift!</b>\r\n\r\nOur latest patch for Rift Reborn is our biggest one yet, and features a number of exciting new gameplay updates which you might want to read about before jumping into your next run.\r\n\r\nThe <b>enemies</b> have received a major overhaul. There are lizards that leap into your backline, plant monsters that yoink far-away heroes at start of the fight, and mushroom mages that cast dangerous AoE spells. We highly recommend <b>right clicking on enemies</b> you haven't encountered before to inspect what their abilities do - positioning your heroes correctly around different enemy abilities and configurations is more important than ever!\r\n\r\nThis patch is also introducing a few major gameplay changes - <b>Hero Stability</b> and <b>The Shard Stabilizer.</b>\r\n\r\n<b>Hero Stability:</b> If your heroes die in combat they will become <b>unstable</b>, and if they die again while unstable they will be <b>banished</b> from The Rift. Don't worry though, you can <b>rest</b> your heroes for one fight to restore their stability, and you can get back your banished heroes at the <b>Campfire</b>. \r\n\r\n<b>The Shard Stabilizer:</b> If your team is defeated in battle, The Shard Stabilizer will keep your run alive and give you a boost of Shards before the next battle. The further you make it before losing a fight, the bigger the Shard boost will be. If your team is defeated a second time, then your run will end in defeat. For those who played Rift Reborn previously, you’ll basically be earning more Shards if you lose your “extra life” on or after the first boss, and less Shards if you are defeated earlier than the first boss.\r\n\r\nWe've made many other changes as well, including but not limited to:\r\n\r\n* Design improvements and balance changes for a significant number of hero active and passive abilities\r\n* Changes to Shard economy\r\n* New UI/UX features\r\n* Continued integration of new sound effects and music\r\n* Replaced many temporary hero and enemy models with finalized models\r\n* New and updated VFX in the fights and menus\r\n\r\nWe can't wait to hear what you all think about these updates, and look forward to seeing you all on the freshly reset leaderboards!\r\n\r\nHappy holidays,\r\nLeyline Studios"
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.952941239, 0.929411829, 0.847058892, 1)
horizontal_alignment = 0
vertical_alignment = 0

